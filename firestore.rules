rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Negação padrão
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helpers
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function userExists() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // IMPORTANTE: mantenha este e-mail igual ao SUPER_ADMIN_EMAILS em src/lib/roles.ts
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "projetocontratosfacul@gmail.com" ||
        (userExists() && userData().role == 'superadmin')
      );
    }

    function myRole() {
      return userExists() ? userData().role : null;
    }

    function myCompany() {
      return userExists() ? userData().companyId : null;
    }

    function isActive() {
      return userExists() && userData().status == 'active';
    }

    function isCompanyAdmin() {
      return isActive() && myRole() == 'company_admin';
    }

    // Gestor = super admin OU admin da empresa
    function isManager() {
      return isSuperAdmin() || isCompanyAdmin();
    }

    // Pertence à empresa cid (usuário ativo)
    function sameCompany(cid) {
      return isActive() && cid == myCompany();
    }

    // Pode escrever documento de negócio da empresa cid
    function canWriteCompany(cid) {
      return isSuperAdmin() || (isCompanyAdmin() && cid == myCompany());
    }

    // Pode ler documento de negócio da empresa cid
    function canReadCompany(cid) {
      return isSuperAdmin() || sameCompany(cid);
    }

    function companyDocFromContract(contractId) {
      return get(/databases/$(database)/documents/contracts/$(contractId)).data.companyId;
    }

    // ===============================================================
    // Empresas (tenants) — só o super admin gerencia
    // ===============================================================
    match /companies/{companyId} {
      allow read: if isSuperAdmin() || (isActive() && myCompany() == companyId);
      allow create, update, delete: if isSuperAdmin();
    }

    // ===============================================================
    // Usuários
    // ===============================================================
    match /users/{uid} {
      allow read: if isSuperAdmin() ||
                     (isActive() && resource.data.companyId == myCompany());

      // Super admin cria qualquer conta; admin da empresa cria dentro da própria empresa
      allow create: if isSuperAdmin() ||
                       (isCompanyAdmin() &&
                        request.resource.data.companyId == myCompany() &&
                        request.resource.data.role in ['user', 'company_admin']);

      // Super admin edita tudo; admin edita usuários da própria empresa;
      // o próprio usuário só pode ajustar nome e a flag de troca de senha.
      allow update: if isSuperAdmin() ||
                       (isCompanyAdmin() && resource.data.companyId == myCompany()) ||
                       (request.auth.uid == uid &&
                        request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['displayName', 'mustChangePassword', 'photoUrl',
                                                   'phone', 'cpf', 'notificationEmail', 'profileComplete']));

      allow delete: if isSuperAdmin();
    }

    // ===============================================================
    // Fornecedores
    // ===============================================================
    match /suppliers/{id} {
      allow read: if canReadCompany(resource.data.companyId);
      allow create: if isManager() &&
                       request.resource.data.companyId != null &&
                       canWriteCompany(request.resource.data.companyId) &&
                       request.resource.data.name is string &&
                       request.resource.data.name.size() > 0;
      allow update: if canWriteCompany(resource.data.companyId);
      allow delete: if canWriteCompany(resource.data.companyId);
    }

    // ===============================================================
    // Contratos
    // ===============================================================
    match /contracts/{contractId} {
      allow read: if canReadCompany(resource.data.companyId);
      allow create: if isManager() &&
                       request.resource.data.companyId != null &&
                       canWriteCompany(request.resource.data.companyId);
      allow update: if canWriteCompany(resource.data.companyId);
      allow delete: if canWriteCompany(resource.data.companyId);

      match /slas/{slaId} {
        allow read: if canReadCompany(companyDocFromContract(contractId));
        allow write: if canWriteCompany(companyDocFromContract(contractId));
      }
    }

    // ===============================================================
    // Arquivos de contrato (PDF em base64) — doc separado por contrato
    // ===============================================================
    match /contractFiles/{id} {
      allow read: if canReadCompany(resource.data.companyId);
      allow create: if isManager() &&
                       request.resource.data.companyId != null &&
                       canWriteCompany(request.resource.data.companyId);
      allow update: if canWriteCompany(resource.data.companyId);
      allow delete: if canWriteCompany(resource.data.companyId);
    }

    // ===============================================================
    // Chamados / Incidentes
    // ===============================================================
    match /incidents/{id} {
      allow read: if canReadCompany(resource.data.companyId);
      allow create: if isManager() &&
                       request.resource.data.companyId != null &&
                       canWriteCompany(request.resource.data.companyId);
      allow update: if canWriteCompany(resource.data.companyId);
      allow delete: if canWriteCompany(resource.data.companyId);
    }

    // ===============================================================
    // Notificações
    // ===============================================================
    match /notifications/{id} {
      allow read: if canReadCompany(resource.data.companyId);
      allow create: if isManager() &&
                       request.resource.data.companyId != null &&
                       canWriteCompany(request.resource.data.companyId);
      // Marcar como lida (qualquer membro ativo da empresa)
      allow update: if sameCompany(resource.data.companyId) &&
                       request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['read']);
      allow delete: if canWriteCompany(resource.data.companyId);
    }

    // ===============================================================
    // Pedidos de assinatura
    // O id do doc é um token aleatório (o "segredo" do link).
    // ===============================================================
    match /signatureRequests/{token} {
      // Leitura pública por token (link de assinatura). Sem listagem
      // para não vazar dados entre empresas.
      allow get: if true;
      allow list: if false;

      // A empresa (gestor) cria o pedido.
      allow create: if isManager() &&
                       request.resource.data.companyId != null &&
                       canWriteCompany(request.resource.data.companyId);

      allow update: if
        // Assinatura pública: marca como assinado UMA vez, só campos da assinatura.
        (resource.data.signed == false &&
         request.resource.data.signed == true &&
         request.resource.data.diff(resource.data)
           .affectedKeys().hasOnly(['signed', 'signerName', 'signedAt', 'signatureData']))
        ||
        // Reconciliação pela empresa: apenas marca reconciled.
        (canWriteCompany(resource.data.companyId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reconciled']));

      allow delete: if canWriteCompany(resource.data.companyId);
    }
  }
}
